# --- Secrets (required) ---
GROQ_API_KEY=your_groq_api_key_here

# --- Tunables (optional; uncomment to override config.py defaults) ---

# LLM served by Groq
# GROQ_MODEL=qwen/qwen3.8-27b

# Local HuggingFace embedding model
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# How many docs to pull per collection (FAQ, tickets, guides). Total = 3 * TOP_K.
# TOP_K=3

# Minimum cosine relevance (0.0-1.0) a doc must score to be used.
# If NO doc from any collection clears this bar, the bot returns a canned
# "I don't have a reliable answer..." response without calling the LLM.
# Typical values for all-MiniLM-L6-v2: 0.30-0.45.
# MIN_RELEVANCE=0.35
